# Copy this file to .env and change the secrets. Never commit .env to Git.

NODE_ENV=development
PORT=5000

# MongoDB 5.0 or newer is required ($setWindowFields is used in reports)
MONGODB_URI=mongodb://127.0.0.1:27017/online_exam_db

# Use two different long random strings, e.g. generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_SALT_ROUNDS=10

# Comma-separated list of allowed origins, or * for any origin (development only)
CORS_ORIGIN=*

# Max login/register/refresh requests per IP per 15 minutes
AUTH_RATE_LIMIT_MAX=100

# How often the background job auto-submits expired attempts
SWEEPER_INTERVAL_SECONDS=30
