{
  "name": "online-exam-backend",
  "version": "1.0.0",
  "description": "Online Examination and Assessment Management System - REST + Socket.IO backend built with Node.js, Express, MongoDB and Mongoose",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "create-admin": "node scripts/create-admin.js",
    "socket:demo": "node scripts/socket-demo.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test tests/unit/evaluation.test.js tests/unit/examWindow.test.js tests/unit/random.test.js",
    "test:integration": "node --test tests/integration/api.test.js"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "socket.io",
    "online-examination"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.2",
    "nodemon": "^3.1.9",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0"
  }
}
